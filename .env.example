# Production template. Do not upload this file as .env without replacing every placeholder.
APP_ENV=production
APP_URL=https://warga-smartdesa.mediaverse.co.id/
APP_TIMEZONE=Asia/Makassar
APP_KEY=replace-with-a-random-secret-at-least-32-characters
WARGA_DEMO_MODE=0

# The central API is kept separate from the existing update API.
WARGA_CENTRAL_API_URL=https://api-warga-smartdesa.mediaverse.co.id/v1/
WARGA_CENTRAL_API_TIMEOUT=15
PRIVATE_STORAGE_PATH=/home/USER/smartdesa-private/warga

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartdesa_warga_pwa
DB_PASS=replace-with-database-password
DB_NAME=smartdesa_warga

# Push Android/PWA. Generate once with: php tools/generate-vapid.php
WARGA_VAPID_SUBJECT=mailto:admin@example.com
WARGA_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WARGA_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
