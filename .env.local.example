# Copy to .env for local UI testing only.
APP_ENV=development
APP_URL=http://localhost/smartdesa-warga/
APP_TIMEZONE=Asia/Makassar
APP_KEY=smartdesa-warga-local-development-key-change-before-production
WARGA_DEMO_MODE=1
WARGA_CENTRAL_API_URL=http://localhost/smartdesa-warga-api/v1/
WARGA_CENTRAL_API_TIMEOUT=15
PRIVATE_STORAGE_PATH=/absolute/path/to/smartdesa-warga/storage
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=smartdesa_warga
